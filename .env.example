# Copy this file to .env and fill in values locally.
# Never commit real credentials.

CLONEID_DB_READONLY_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/CLONEID

# Optional: path to a local PhysiCell executable for local-test or execute mode.
PHYSICELL_BIN=/path/to/PhysiCell

# Optional: default OpenMP thread count for PhysiCell runs.
OMP_NUM_THREADS=4
